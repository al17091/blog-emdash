---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Icon from '../../components/ui/Icon.astro';
import { formatPublishedDate } from '../../lib/formatDate';

const posts = (await getCollection('blog', ({ data }) => data.category === 'tech')).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
const tagFilters = ['all', ...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout title="フリーダム旅行記 | Tech & Dev">
  <main class="blog-page">
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">フリーダム旅行記</a>
        <nav class="site-nav" aria-label="blog categories">
          <a class="active" href="/blog/tech">Tech</a>
          <a href="/blog/nature">登山</a>
          <a href="/blog/travel">旅記録</a>
        </nav>
        <div class="header-actions">
          <input type="search" placeholder="記事を検索..." aria-label="記事を検索" />
          <button type="button" aria-label="search"><Icon name="search" size={16} /></button>
          <a class="icon-button" href="/rss.xml" aria-label="RSS feed" title="rss"><Icon name="rss" size={16} /></a>
        </div>
      </div>
    </header>

    <section class="container category-head">
      <p class="crumb">Portal / <strong>Tech &amp; Dev</strong></p>
      <h1>Astro &amp; GitOps 開発記</h1>
      <p class="lead">AstroとGitOpsをベースとしたモダンな開発とライフスタイル。全ての記事はGitで管理されています。</p>
    </section>

    <section class="container toolbar" aria-label="post tools">
      <p>Showing <span data-post-count>{posts.length}</span> posts</p>
      <div class="toolbar-actions">
        <div class="tag-filters" aria-label="tag filters">
          {tagFilters.map((tag) => (
            <button
              type="button"
              data-tag-filter={tag}
              class:list={['tag-filter', tag === 'all' && 'active']}
            >
              {tag === 'all' ? 'All' : tag}
            </button>
          ))}
        </div>
        <button type="button">Newest First</button>
      </div>
    </section>

    <section class="container post-grid" aria-label="tech posts" data-post-grid data-posts-per-page="8">
      {posts.map((post) => (
        <article class="post-card" data-post-card data-tags={post.data.tags.join('|')}>
          <img src={post.data.cardImage} alt={post.data.title} loading="lazy" />
          <div class="tags">
            {post.data.tags.map((tag) => (
              <button type="button" data-tag-filter={tag} class="tag-chip">{tag}</button>
            ))}
          </div>
          <a class="post-body post-link" href={`/blog/tech/${post.data.routeSlug}`} aria-label={post.data.title}>
            <p class="meta">{formatPublishedDate(post.data.publishedDate)} · {post.data.readTime}</p>
            <h2>{post.data.title}</h2>
            <p class="desc">{post.data.description}</p>
            <span class="hint" aria-hidden="true"></span>
          </a>
        </article>
      ))}
    </section>

    <nav class="container pager" aria-label="pagination" data-pager>
      <button type="button" data-pager-prev aria-label="Previous page">&lt;</button>
      <div class="pager-pages" data-pager-pages></div>
      <button type="button" data-pager-next aria-label="Next page">&gt;</button>
    </nav>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <strong>フリーダム旅行記</strong>
        <div class="links">
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
          <a href="/newsletter">Newsletter</a>
        </div>
        <p>© 2023 Freedom Travel Journal. All rights reserved.</p>
      </div>
    </footer>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const grid = document.querySelector('[data-post-grid]');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('[data-post-card]'));
    const buttons = Array.from(document.querySelectorAll('[data-tag-filter]'));
    const count = document.querySelector('[data-post-count]');
    let active = 'all';
    let page = 1;
    const perPage = Number(grid.getAttribute('data-posts-per-page') || '8');
    const prev = document.querySelector('[data-pager-prev]');
    const next = document.querySelector('[data-pager-next]');
    const pagesWrap = document.querySelector('[data-pager-pages]');

    const render = () => {
      const filtered = cards.filter((card) => {
        const tags = (card.getAttribute('data-tags') || '').split('|').filter(Boolean);
        return active === 'all' || tags.includes(active);
      });

      const total = filtered.length;
      const totalPages = Math.max(1, Math.ceil(total / perPage));
      page = Math.min(page, totalPages);
      const start = (page - 1) * perPage;
      const end = start + perPage;

      cards.forEach((card) => (card.style.display = 'none'));
      filtered.slice(start, end).forEach((card) => (card.style.display = ''));
      if (count) count.textContent = String(total);

      if (pagesWrap) {
        pagesWrap.innerHTML = '';
        for (let i = 1; i <= totalPages; i += 1) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = String(i);
          btn.className = i === page ? 'active' : '';
          btn.addEventListener('click', () => {
            page = i;
            render();
          });
          pagesWrap.appendChild(btn);
        }
      }

      if (prev) prev.disabled = page <= 1;
      if (next) next.disabled = page >= totalPages;
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        active = button.getAttribute('data-tag-filter') || 'all';
        page = 1;
        buttons.forEach((b) => b.classList.toggle('active', b === button));
        render();
      });
    });

    prev?.addEventListener('click', () => {
      page = Math.max(1, page - 1);
      render();
    });
    next?.addEventListener('click', () => {
      page += 1;
      render();
    });

    render();
  })();
</script>

<style>
  .blog-page {
    min-height: 100vh;
    padding: 0;
    background: #f6f7f8;
    color: #0f172a;
  }

  .container {
    width: min(1280px, calc(100% - 48px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #ffffffd9;
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #dde4ee;
  }

  .site-header-inner {
    width: min(1520px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    color: #0f172a;
    text-decoration: none;
    font-weight: 700;
  }

  .site-nav {
    display: flex;
    gap: 1.1rem;
    align-items: center;
  }

  .site-nav a {
    color: #475569;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    padding-bottom: 0.25rem;
  }

  .site-nav a.active {
    color: #1976d2;
    border-bottom: 2px solid #1976d2;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .header-actions input {
    border: 1px solid #d5deea;
    border-radius: 10px;
    background: #fff;
    padding: 0.55rem 0.8rem;
    min-width: 220px;
  }

  .header-actions button,
  .header-actions .icon-button {
    border: 1px solid #d5deea;
    background: #fff;
    border-radius: 10px;
    width: 36px;
    height: 36px;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .category-head {
    padding-top: 2.5rem;
  }

  .crumb {
    margin: 0;
    color: #64748b;
    font-size: 0.86rem;
  }

  .crumb strong {
    color: #1976d2;
  }

  h1 {
    margin: 0.7rem 0 0.5rem;
    font-size: clamp(1.9rem, 2.6vw, 3rem);
    line-height: 1.08;
  }

  .lead {
    margin: 0;
    color: #475569;
    max-width: 70ch;
    font-size: 1.06rem;
    line-height: 1.65;
  }

  .toolbar {
    margin-top: 1.6rem;
    border-top: 1px solid #d9e2ee;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .toolbar p {
    margin: 0;
    color: #64748b;
    font-size: 0.92rem;
  }

  .toolbar-actions {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .tag-filters {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .tag-filter {
    border: 1px solid #d2dcea;
    background: #fff;
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    color: #334155;
    font-weight: 600;
    font-size: 0.78rem;
  }

  .tag-filter.active {
    background: #1976d2;
    border-color: #1976d2;
    color: #fff;
  }

  .toolbar-actions button {
    border: 1px solid #d2dcea;
    background: #fff;
    border-radius: 8px;
    padding: 0.55rem 0.85rem;
    color: #334155;
    font-weight: 600;
  }

  .toolbar-actions button.primary {
    background: #1976d2;
    border-color: #1976d2;
    color: #fff;
  }

  .post-grid {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .post-card {
    border: 1px solid #d8e1ec;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
    position: relative;
    display: grid;
  }

  .post-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .tags {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-chip {
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    background: #1976d2;
    border: 0;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .post-body {
    padding: 0.9rem 0.9rem 0.35rem;
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
  }

  .meta {
    margin: 0;
    color: #64748b;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  h2 {
    margin: 0.6rem 0 0.45rem;
    font-size: 1.14rem;
    line-height: 1.35;
  }

  .desc {
    margin: 0;
    color: #475569;
    line-height: 1.55;
    font-size: 0.93rem;
    min-height: 4.3em;
  }

  .hint {
    position: absolute;
    right: 0.35rem;
    bottom: 0.35rem;
    width: 16px;
    height: 16px;
    pointer-events: none;
    transition: transform 180ms ease;
  }

  .hint::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 50%, #9eb0c7 50%);
    border-bottom-right-radius: 3px;
  }

  .hint::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 9px;
    height: 9px;
    border-right: 1px solid #7f95af;
    border-bottom: 1px solid #7f95af;
    border-bottom-right-radius: 2px;
  }

  .post-link:hover .hint {
    transform: scale(1.1);
  }


  .pager {
    margin-top: 2rem;
    margin-bottom: 3rem;
    display: flex;
    gap: 0.45rem;
    justify-content: center;
    align-items: center;
  }

  .pager button {
    min-width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid #d5deea;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #334155;
    background: #fff;
    font-weight: 600;
  }

  .pager button.active {
    background: #1976d2;
    border-color: #1976d2;
    color: #fff;
  }

  .pager-pages {
    display: inline-flex;
    gap: 0.45rem;
  }

  .site-footer {
    border-top: 1px solid #dde5f0;
    background: #f3f5f8;
    padding: 1.1rem 0 1.5rem;
  }

  .site-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem;
    color: #64748b;
    font-size: 0.9rem;
  }

  .links {
    display: flex;
    gap: 1rem;
  }

  .links a {
    color: #64748b;
    text-decoration: none;
  }

  @media (max-width: 1200px) {
    .post-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .site-nav {
      display: none;
    }

    .site-header-inner,
    .container {
      width: min(1280px, calc(100% - 24px));
    }

    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 620px) {
    .header-actions input {
      min-width: 130px;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }

    .toolbar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
