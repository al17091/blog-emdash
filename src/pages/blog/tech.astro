---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryPosts } from '../../data/blogArticles';

const posts = categoryPosts.tech;
---

<BaseLayout title="フリーダム旅行記 | Tech & Dev">
  <main class="blog-page">
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">フリーダム旅行記</a>
        <nav class="site-nav" aria-label="blog categories">
          <a class="active" href="/blog/tech">Tech</a>
          <a href="/blog/nature">登山</a>
          <a href="/blog/travel">旅記録</a>
        </nav>
        <div class="header-actions">
          <input type="search" placeholder="記事を検索..." aria-label="記事を検索" />
          <button type="button" aria-label="profile">◎</button>
        </div>
      </div>
    </header>

    <section class="container category-head">
      <p class="crumb">Portal / <strong>Tech &amp; Dev</strong></p>
      <h1>Astro &amp; GitOps 開発記</h1>
      <p class="lead">AstroとGitOpsをベースとしたモダンな開発とライフスタイル。全ての記事はGitで管理されています。</p>
    </section>

    <section class="container toolbar" aria-label="post tools">
      <p>Showing {posts.length} posts</p>
      <div class="toolbar-actions">
        <button type="button">Newest First</button>
        <button type="button" class="primary">Filters</button>
      </div>
    </section>

    <section class="container post-grid" aria-label="tech posts">
      {posts.map((post) => (
        <article class="post-card">
          <img src={post.image} alt={post.title} loading="lazy" />
          <div class="tags">
            {post.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
          <div class="post-body">
            <p class="meta">{post.date} · {post.readTime}</p>
            <h2>{post.title}</h2>
            <p class="desc">{post.description}</p>
          </div>
          <footer class="card-footer">
            <span>{post.author}</span>
            <a href={`/blog/tech/${post.slug}`} aria-label={`${post.title} read more`}>→</a>
          </footer>
        </article>
      ))}
    </section>

    <nav class="container pager" aria-label="pagination">
      <a href="/blog/tech">&lt;</a>
      <a class="active" href="/blog/tech">1</a>
      <a href="/blog/tech">2</a>
      <a href="/blog/tech">3</a>
      <span>...</span>
      <a href="/blog/tech">12</a>
      <a href="/blog/tech">&gt;</a>
    </nav>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <strong>フリーダム旅行記</strong>
        <div class="links">
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
          <a href="/newsletter">Newsletter</a>
        </div>
        <p>© 2023 Freedom Travel Journal. All rights reserved.</p>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .blog-page {
    min-height: 100vh;
    padding: 0;
    background: #f6f7f8;
    color: #0f172a;
  }

  .container {
    width: min(1280px, calc(100% - 48px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #ffffffd9;
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #dde4ee;
  }

  .site-header-inner {
    width: min(1520px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    color: #0f172a;
    text-decoration: none;
    font-weight: 700;
  }

  .site-nav {
    display: flex;
    gap: 1.1rem;
    align-items: center;
  }

  .site-nav a {
    color: #475569;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    padding-bottom: 0.25rem;
  }

  .site-nav a.active {
    color: #1976d2;
    border-bottom: 2px solid #1976d2;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .header-actions input {
    border: 1px solid #d5deea;
    border-radius: 10px;
    background: #fff;
    padding: 0.55rem 0.8rem;
    min-width: 220px;
  }

  .header-actions button {
    border: 1px solid #d5deea;
    background: #fff;
    border-radius: 10px;
    width: 36px;
    height: 36px;
    color: #64748b;
  }

  .category-head {
    padding-top: 2.5rem;
  }

  .crumb {
    margin: 0;
    color: #64748b;
    font-size: 0.86rem;
  }

  .crumb strong {
    color: #1976d2;
  }

  h1 {
    margin: 0.7rem 0 0.5rem;
    font-size: clamp(1.9rem, 2.6vw, 3rem);
    line-height: 1.08;
  }

  .lead {
    margin: 0;
    color: #475569;
    max-width: 70ch;
    font-size: 1.06rem;
    line-height: 1.65;
  }

  .toolbar {
    margin-top: 1.6rem;
    border-top: 1px solid #d9e2ee;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .toolbar p {
    margin: 0;
    color: #64748b;
    font-size: 0.92rem;
  }

  .toolbar-actions {
    display: flex;
    gap: 0.7rem;
  }

  .toolbar-actions button {
    border: 1px solid #d2dcea;
    background: #fff;
    border-radius: 8px;
    padding: 0.55rem 0.85rem;
    color: #334155;
    font-weight: 600;
  }

  .toolbar-actions button.primary {
    background: #1976d2;
    border-color: #1976d2;
    color: #fff;
  }

  .post-grid {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .post-card {
    border: 1px solid #d8e1ec;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .post-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .tags {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags span {
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    background: #1976d2;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .post-body {
    padding: 0.9rem 0.9rem 0.35rem;
  }

  .meta {
    margin: 0;
    color: #64748b;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  h2 {
    margin: 0.6rem 0 0.45rem;
    font-size: 1.14rem;
    line-height: 1.35;
  }

  .desc {
    margin: 0;
    color: #475569;
    line-height: 1.55;
    font-size: 0.93rem;
    min-height: 4.3em;
  }

  .card-footer {
    border-top: 1px solid #e6edf6;
    padding: 0.85rem 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #334155;
    font-weight: 600;
    font-size: 0.88rem;
  }

  .card-footer a {
    color: #6b7f97;
    text-decoration: none;
    font-size: 1.2rem;
    line-height: 1;
  }

  .pager {
    margin-top: 2rem;
    margin-bottom: 3rem;
    display: flex;
    gap: 0.45rem;
    justify-content: center;
    align-items: center;
  }

  .pager a,
  .pager span {
    min-width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid #d5deea;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #334155;
    background: #fff;
    font-weight: 600;
  }

  .pager a.active {
    background: #1976d2;
    border-color: #1976d2;
    color: #fff;
  }

  .site-footer {
    border-top: 1px solid #dde5f0;
    background: #f3f5f8;
    padding: 1.1rem 0 1.5rem;
  }

  .site-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem;
    color: #64748b;
    font-size: 0.9rem;
  }

  .links {
    display: flex;
    gap: 1rem;
  }

  .links a {
    color: #64748b;
    text-decoration: none;
  }

  @media (max-width: 1200px) {
    .post-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .site-nav {
      display: none;
    }

    .site-header-inner,
    .container {
      width: min(1280px, calc(100% - 24px));
    }

    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 620px) {
    .header-actions input {
      min-width: 130px;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }

    .toolbar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
