---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Icon from '../../components/ui/Icon.astro';
import { formatPublishedDate } from '../../lib/formatDate';

const posts = (await getCollection('blog', ({ data }) => data.category === 'nature')).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
const tagFilters = ['all', ...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout title="素人登山道 | Nature">
  <main class="nature-page">
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">素人登山道</a>
        <nav class="nav" aria-label="blog categories">
          <a href="/blog/tech">Tech</a>
          <a class="active" href="/blog/nature">登山</a>
          <a href="/blog/travel">旅記録</a>
        </nav>
        <div class="actions">
          <input type="search" placeholder="Search trails..." aria-label="search trails" />
          <button type="button" aria-label="search"><Icon name="search" size={16} /></button>
          <a class="icon-button" href="/rss.xml" aria-label="RSS feed" title="rss"><Icon name="rss" size={16} /></a>
        </div>
      </div>
    </header>

    <section class="container hero" aria-label="category hero">
      <img
        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1800&q=80"
        alt="Mountain range"
      />
      <div class="hero-overlay">
        <h1>素人登山道</h1>
        <p>Nature-inspired records of mountain climbs, gear reviews, and quiet trail lessons.</p>
      </div>
    </section>

    <section class="container list-head">
      <p class="crumb">Portal / <strong>Nature</strong></p>
      <div class="list-controls" aria-label="list controls">
        <button type="button" aria-label="grid"><Icon name="grid" size={14} /></button>
        <button type="button" aria-label="list"><Icon name="list" size={14} /></button>
        <button type="button" class="select">Newest ▾</button>
      </div>
    </section>

    <section class="container tag-filters-wrap" aria-label="tag filters">
      <p>Showing <span data-post-count>{posts.length}</span> posts</p>
      <div class="tag-filters">
        {tagFilters.map((tag) => (
          <button type="button" data-tag-filter={tag} class:list={['tag-filter', tag === 'all' && 'active']}>
            {tag === 'all' ? 'All' : tag}
          </button>
        ))}
      </div>
    </section>

    <section class="container grid" aria-label="nature posts" data-post-grid data-posts-per-page="8">
      {posts.map((post) => (
        <article class="card" data-post-card data-tags={post.data.tags.join('|')}>
          <div class="media">
            <img src={post.data.cardImage} alt={post.data.title} loading="lazy" />
            <button type="button" data-tag-filter={post.data.tags[0]} class="tag-chip">{post.data.tags[0]}</button>
          </div>
          <a class="content post-link" href={`/blog/nature/${post.data.routeSlug}`} aria-label={post.data.title}>
            <p class="meta">{formatPublishedDate(post.data.publishedDate)}</p>
            <h2>{post.data.title}</h2>
            <p class="desc">{post.data.description}</p>
            <p class="time">{post.data.readTime}</p>
            <span class="hint" aria-hidden="true"></span>
          </a>
        </article>
      ))}
    </section>

    <nav class="container pager" aria-label="pagination" data-pager>
      <button type="button" data-pager-prev aria-label="Previous page">&lt;</button>
      <div class="pager-pages" data-pager-pages></div>
      <button type="button" data-pager-next aria-label="Next page">&gt;</button>
    </nav>

    <footer class="site-footer">
      <div class="container footer-grid">
        <section>
          <h3>素人登山道</h3>
          <p>
            A personal archive of mountain climbs, gear reflections, and lessons learned on the trail. Documenting the
            quiet journey from the forest floor to the summit.
          </p>
        </section>
        <section>
          <h3>Categories</h3>
          <a href="/blog/nature">Climb Records</a>
          <a href="/blog/nature">Gear Reviews</a>
          <a href="/blog/nature">Trail Lessons</a>
          <a href="/blog/nature">Safety Guides</a>
        </section>
        <section>
          <h3>About</h3>
          <a href="/about">Our Story</a>
          <a href="/about">Meet the Hikers</a>
          <a href="/contact">Contact Us</a>
          <a href="/privacy-policy">Privacy Policy</a>
        </section>
      </div>
      <p class="copy">© 2023 素人登山道 (Amateur Mountain Path). All rights reserved.</p>
    </footer>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const grid = document.querySelector('[data-post-grid]');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll('[data-post-card]'));
    const buttons = Array.from(document.querySelectorAll('[data-tag-filter]'));
    const count = document.querySelector('[data-post-count]');
    let active = 'all';
    let page = 1;
    const perPage = Number(grid.getAttribute('data-posts-per-page') || '8');
    const prev = document.querySelector('[data-pager-prev]');
    const next = document.querySelector('[data-pager-next]');
    const pagesWrap = document.querySelector('[data-pager-pages]');
    const render = () => {
      const filtered = cards.filter((card) => {
        const tags = (card.getAttribute('data-tags') || '').split('|').filter(Boolean);
        return active === 'all' || tags.includes(active);
      });

      const total = filtered.length;
      const totalPages = Math.max(1, Math.ceil(total / perPage));
      page = Math.min(page, totalPages);
      const start = (page - 1) * perPage;
      const end = start + perPage;

      cards.forEach((card) => (card.style.display = 'none'));
      filtered.slice(start, end).forEach((card) => (card.style.display = ''));
      if (count) count.textContent = String(total);

      if (pagesWrap) {
        pagesWrap.innerHTML = '';
        for (let i = 1; i <= totalPages; i += 1) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = String(i);
          btn.className = i === page ? 'active' : '';
          btn.addEventListener('click', () => {
            page = i;
            render();
          });
          pagesWrap.appendChild(btn);
        }
      }

      if (prev) prev.disabled = page <= 1;
      if (next) next.disabled = page >= totalPages;
    };
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        active = button.getAttribute('data-tag-filter') || 'all';
        page = 1;
        buttons.forEach((b) => b.classList.toggle('active', b === button));
        render();
      });
    });
    prev?.addEventListener('click', () => {
      page = Math.max(1, page - 1);
      render();
    });
    next?.addEventListener('click', () => {
      page += 1;
      render();
    });
    render();
  })();
</script>

<style>
  .nature-page {
    min-height: 100vh;
    padding: 0;
    background: #f8faf9;
    color: #1f2937;
  }

  .container {
    width: min(1280px, calc(100% - 48px));
    margin: 0 auto;
  }

  .topbar {
    border-bottom: 1px solid #d9e2de;
    background: #f8faf9d9;
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .topbar-inner {
    width: min(1560px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    text-decoration: none;
    color: #1d4f2f;
    font-weight: 800;
    font-size: 1.38rem;
  }

  .nav {
    display: flex;
    gap: 1.3rem;
  }

  .nav a {
    text-decoration: none;
    color: #475569;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .nav a.active {
    color: #1d4f2f;
  }

  .actions {
    display: flex;
    gap: 0.55rem;
    align-items: center;
  }

  .actions input {
    min-width: 238px;
    border: 1px solid #d6e0dc;
    border-radius: 10px;
    background: #f2f7f4;
    padding: 0.56rem 0.82rem;
  }

  .actions button,
  .actions .icon-button {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid #d6e0dc;
    background: #fff;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .hero {
    margin-top: 1.6rem;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    min-height: 340px;
  }

  .hero img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    display: block;
    filter: saturate(0.7) contrast(0.9);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 21, 17, 0.14) 20%, rgba(7, 20, 16, 0.66) 100%);
    padding: 2.2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  h1 {
    margin: 0;
    color: #f8faf8;
    font-size: clamp(2.2rem, 4.2vw, 4rem);
    line-height: 1.05;
  }

  .hero-overlay p {
    margin: 0.65rem 0 0;
    color: #d7e7df;
    font-size: 1.2rem;
    max-width: 48ch;
    line-height: 1.45;
  }

  .list-head {
    margin-top: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .crumb {
    margin: 0;
    color: #6b7280;
    font-size: 0.86rem;
  }

  .crumb strong {
    color: #2f6c41;
  }

  .list-controls {
    display: flex;
    gap: 0.5rem;
  }

  .list-controls button {
    border: 1px solid #d6e0dc;
    border-radius: 9px;
    background: #fff;
    color: #4b5563;
    min-width: 38px;
    height: 38px;
    padding: 0 0.7rem;
    font-weight: 700;
  }

  .list-controls .select {
    min-width: 102px;
  }

  .tag-filters-wrap {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .tag-filters-wrap p {
    margin: 0;
    color: #6b7280;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .tag-filters {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .tag-filter {
    border: 1px solid #d6e0dc;
    border-radius: 999px;
    background: #fff;
    color: #2f6c41;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.3rem 0.6rem;
  }

  .tag-filter.active {
    background: #2f6c41;
    border-color: #2f6c41;
    color: #fff;
  }

  .grid {
    margin-top: 1.1rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .card {
    border: 1px solid #e0e7e3;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
  }

  .media {
    position: relative;
  }

  .media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .tag-chip {
    position: absolute;
    left: 0.56rem;
    top: 0.56rem;
    padding: 0.22rem 0.5rem;
    border-radius: 6px;
    background: #f1f7f3;
    border: 1px solid #c8d9cf;
    color: #264735;
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    cursor: pointer;
  }

  .content {
    padding: 0.8rem 0.75rem 0.9rem;
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
  }

  .meta {
    margin: 0;
    color: #94a3b8;
    font-size: 0.77rem;
    font-weight: 600;
  }

  h2 {
    margin: 0.56rem 0 0.5rem;
    font-size: 1.12rem;
    line-height: 1.35;
    color: #0f172a;
  }

  .desc {
    margin: 0;
    color: #475569;
    font-size: 0.92rem;
    line-height: 1.5;
    min-height: 4.5em;
  }

  .time {
    margin: 0.85rem 0 0;
    color: #94a3b8;
    font-size: 0.74rem;
    font-weight: 600;
  }

  .hint {
    position: absolute;
    right: 0.35rem;
    bottom: 0.35rem;
    width: 16px;
    height: 16px;
    pointer-events: none;
    transition: transform 180ms ease;
  }

  .hint::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 50%, #8db29a 50%);
    border-bottom-right-radius: 3px;
  }

  .hint::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 9px;
    height: 9px;
    border-right: 1px solid #6e8b77;
    border-bottom: 1px solid #6e8b77;
    border-bottom-right-radius: 2px;
  }

  .post-link:hover .hint {
    transform: scale(1.1);
  }


  .pager {
    margin-top: 2rem;
    margin-bottom: 4rem;
    display: flex;
    gap: 0.45rem;
    align-items: center;
    justify-content: center;
  }

  .pager button {
    min-width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid #d8e3de;
    background: #fff;
    color: #334155;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .pager button.active {
    background: #2f6c41;
    border-color: #2f6c41;
    color: #fff;
  }

  .pager-pages {
    display: inline-flex;
    gap: 0.45rem;
  }

  .site-footer {
    border-top: 1px solid #dde5e1;
    background: #f8faf9;
    padding: 2.1rem 0 1.3rem;
  }

  .footer-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 2fr 1fr 1fr;
  }

  .footer-grid h3 {
    margin: 0 0 0.9rem;
    color: #1f2937;
    font-size: 1.1rem;
  }

  .footer-grid p {
    margin: 0;
    color: #64748b;
    line-height: 1.6;
    max-width: 42ch;
  }

  .footer-grid a {
    display: block;
    text-decoration: none;
    color: #64748b;
    margin-bottom: 0.62rem;
  }

  .copy {
    margin: 1.5rem auto 0;
    width: min(1280px, calc(100% - 48px));
    border-top: 1px solid #e4ebe7;
    padding-top: 1rem;
    color: #94a3b8;
    font-size: 0.82rem;
    text-align: center;
  }

  @media (max-width: 1200px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .nav {
      display: none;
    }

    .container,
    .topbar-inner,
    .copy {
      width: min(1280px, calc(100% - 24px));
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .actions input {
      min-width: 120px;
    }

    .hero img {
      height: 280px;
    }

    .hero-overlay p {
      font-size: 1rem;
    }

    .list-head {
      flex-direction: column;
      align-items: flex-start;
    }

    .tag-filters-wrap {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
