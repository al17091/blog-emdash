---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Icon from '../../../components/ui/Icon.astro';
import { formatPublishedDate } from '../../../lib/formatDate';

const category = Astro.params.category ?? '';
const slug = Astro.params.slug ?? '';

const allEntries = await getCollection('blog');

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries.map((entry) => ({
    params: {
      category: entry.data.category,
      slug: entry.data.routeSlug,
    },
  }));
}

const article = allEntries.find((entry) => entry.data.category === category && entry.data.routeSlug === slug);

if (!article) {
  throw new Error(`Article not found: ${category}/${slug}`);
}

const { Content } = await article.render();

const related = allEntries
  .filter((entry) => entry.data.category === article.data.category && entry.data.routeSlug !== article.data.routeSlug)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 3);

const themeByCategory = {
  tech: {
    accent: '#1976d2',
    accentSoft: '#edf4ff',
    line: '#d6e3f4',
    navBg: '#f6f9fd',
    codeBg: '#0b1631',
    brand: 'I am Engineer',
    nav: ['Articles', 'Tutorials', 'Architecture', 'Cloud'],
    categoryLabel: 'Tech Blog',
  },
  nature: {
    accent: '#2f6c41',
    accentSoft: '#eff6f1',
    line: '#d9e7dc',
    navBg: '#f7faf8',
    codeBg: '#102317',
    brand: 'Amateur Mountain Path',
    nav: ['Climb Records', 'Gear Reviews', 'Trail Lessons', 'About'],
    categoryLabel: 'Nature',
  },
  travel: {
    accent: '#b35b1f',
    accentSoft: '#fdf3ea',
    line: '#ebdccf',
    navBg: '#fffaf4',
    codeBg: '#2f1b12',
    brand: 'Freedom Travel Journal',
    nav: ['Journal', 'Routes', 'Food', 'About'],
    categoryLabel: 'Travel Log',
  },
}[article.data.category];

const heroImage = article.data.heroImage ?? article.data.cardImage;
---

<BaseLayout title={`${article.data.title} | ${themeByCategory.brand}`} description={article.data.description}>
  <main class="article-page">
    <header class="topbar" style={`--accent:${themeByCategory.accent};--line:${themeByCategory.line};--nav-bg:${themeByCategory.navBg}`}>
      <div class="topbar-inner">
        <a class="brand" href={`/blog/${article.data.category}`}>{themeByCategory.brand}</a>
        <nav aria-label="section links">
          {themeByCategory.nav.map((item) => (
            <a href={`/blog/${article.data.category}`}>{item}</a>
          ))}
        </nav>
        <div class="actions">
          <input type="search" placeholder="Search" aria-label="Search" />
          <button type="button" aria-label="Search"><Icon name="search" size={16} /></button>
          <a class="icon-button" href="/rss.xml" aria-label="RSS feed" title="rss"><Icon name="rss" size={16} /></a>
        </div>
      </div>
    </header>

    <article class="wrap article-body" style={`--accent:${themeByCategory.accent};--accent-soft:${themeByCategory.accentSoft};--line:${themeByCategory.line};--code-bg:${themeByCategory.codeBg}`}>
      <p class="crumb">Portal / {themeByCategory.categoryLabel} / {article.data.title}</p>
      <h1>{article.data.title}</h1>
      <p class="dek">{article.data.description}</p>

      <p class="byline">
        <strong>{article.data.author}</strong>
        <span>{formatPublishedDate(article.data.publishedDate)}</span>
      </p>

      <figure class="hero-image">
        <img src={heroImage} alt={article.data.title} />
      </figure>

      <section class="markdown-body">
        <Content />
      </section>

      <div class="share">
        <span>SHARE THIS ARTICLE:</span>
        <button type="button" aria-label="Share to feed"><Icon name="share" size={14} /></button>
        <button type="button" aria-label="Share to x"><Icon name="x" size={14} /></button>
        <button type="button" aria-label="Share to link"><Icon name="linkedin" size={14} /></button>
      </div>

      <section class="related" aria-label="Related articles">
        <h3>Related Articles</h3>
        <div class="related-grid">
          {related.map((item) => (
            <a class="related-card" href={`/blog/${item.data.category}/${item.data.routeSlug}`}>
              <img src={item.data.cardImage} alt={item.data.title} loading="lazy" />
              <small>{item.data.tags[0] ?? item.data.category}</small>
              <h4>{item.data.title}</h4>
              <p>
                {formatPublishedDate(item.data.publishedDate)} - {item.data.readTime}
              </p>
            </a>
          ))}
        </div>
      </section>
    </article>

    <footer class="site-footer" style={`--line:${themeByCategory.line};--accent:${themeByCategory.accent}`}>
      <div class="wrap footer-grid">
        <section>
          <h4>{themeByCategory.brand}</h4>
          <p>Empowering creators with focused writing, curated stories, and long-term archives.</p>
        </section>
        <section>
          <h4>Resources</h4>
          <a href="/blog">Documentation</a>
          <a href="/blog">Case Studies</a>
          <a href="/blog">Whitepapers</a>
        </section>
        <section>
          <h4>Company</h4>
          <a href="/about">About Us</a>
          <a href="/contact">Contact</a>
          <a href="/about">Careers</a>
        </section>
        <section>
          <h4>Newsletter</h4>
          <div class="newsletter">
            <input type="email" placeholder="email@example.com" aria-label="Email" />
            <button type="button">Subscribe</button>
          </div>
        </section>
      </div>
      <p class="copyright">© 2023 {themeByCategory.brand}. All rights reserved.</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .article-page {
    min-height: 100vh;
    padding: 0;
    background: #f6f7f8;
    color: #0f172a;
  }

  .wrap {
    width: min(980px, calc(100% - 48px));
    margin: 0 auto;
  }

  .topbar {
    border-bottom: 1px solid var(--line);
    background: var(--nav-bg);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .topbar-inner {
    width: min(1280px, calc(100% - 48px));
    margin: 0 auto;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    color: #0f172a;
    text-decoration: none;
    font-weight: 800;
  }

  nav {
    display: flex;
    gap: 1rem;
  }

  nav a {
    text-decoration: none;
    color: #475569;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .actions input {
    min-width: 210px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #f2f5f9;
    padding: 0.5rem 0.75rem;
  }

  .actions button,
  .actions .icon-button {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #f8fafc;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .article-body {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .crumb {
    margin: 0;
    color: #64748b;
    font-size: 0.8rem;
  }

  h1 {
    margin: 0.7rem 0 0;
    font-size: clamp(2rem, 4vw, 3.7rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .dek {
    margin-top: 0.8rem;
    color: #475569;
    font-size: 1.45rem;
    line-height: 1.45;
    max-width: 52ch;
  }

  .byline {
    margin: 1.6rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.95rem;
  }

  .byline span {
    color: #64748b;
  }

  .hero-image {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }

  .markdown-body :global(h2),
  .markdown-body :global(h3) {
    margin: 1.9rem 0 0.65rem;
    font-size: 1.8rem;
    line-height: 1.2;
  }

  .markdown-body :global(p),
  .markdown-body :global(li) {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #334155;
  }

  .markdown-body :global(ul),
  .markdown-body :global(ol) {
    padding-left: 1.25rem;
  }

  .markdown-body :global(pre) {
    margin: 1rem 0;
    padding: 1rem;
    border-radius: 8px;
    background: var(--code-bg);
    color: #bfdbfe;
    overflow-x: auto;
    border: 1px solid color-mix(in srgb, var(--line) 60%, #0f172a 40%);
  }

  .share {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .share span {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #64748b;
  }

  .share button {
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 7px;
    color: #334155;
    font-weight: 700;
  }

  .related {
    margin-top: 3rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .related-card {
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    color: inherit;
  }

  .related-card img {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    display: block;
  }

  .related-card small,
  .related-card h4,
  .related-card p {
    margin: 0;
    padding: 0 0.65rem;
  }

  .related-card small {
    padding-top: 0.5rem;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.03em;
  }

  .related-card h4 {
    padding-top: 0.32rem;
    font-size: 0.98rem;
    line-height: 1.35;
    color: #0f172a;
  }

  .related-card p {
    padding-top: 0.34rem;
    padding-bottom: 0.65rem;
    color: #64748b;
    font-size: 0.78rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    background: #f5f7fa;
    padding: 2rem 0 1.4rem;
  }

  .footer-grid {
    width: min(1280px, calc(100% - 48px));
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 1rem;
  }

  .footer-grid h4 {
    margin: 0;
    font-size: 0.95rem;
    color: #0f172a;
  }

  .footer-grid p {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.55;
  }

  .footer-grid a {
    display: block;
    margin-top: 0.45rem;
    color: #64748b;
    text-decoration: none;
    font-size: 0.84rem;
  }

  .newsletter {
    margin-top: 0.6rem;
    display: flex;
    gap: 0.4rem;
  }

  .newsletter input {
    min-width: 110px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: #fff;
    padding: 0.45rem 0.55rem;
  }

  .newsletter button {
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    border-radius: 7px;
    padding: 0.45rem 0.7rem;
    font-weight: 700;
  }

  .copyright {
    width: min(1280px, calc(100% - 48px));
    margin: 1rem auto 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    text-align: center;
    color: #94a3b8;
    font-size: 0.78rem;
  }

  @media (max-width: 1100px) {
    .related-grid {
      grid-template-columns: 1fr;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    h1 {
      font-size: clamp(1.9rem, 5vw, 2.7rem);
    }

    .dek {
      font-size: 1rem;
    }
  }

  @media (max-width: 780px) {
    nav {
      display: none;
    }

    .actions input {
      display: none;
    }

    .wrap,
    .topbar-inner,
    .footer-grid,
    .copyright {
      width: min(1280px, calc(100% - 24px));
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
