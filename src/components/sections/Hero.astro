---
interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  primaryCta: {
    label: string;
    href: string;
  };
  secondaryCta: {
    label: string;
    href: string;
  };
}

const { eyebrow, heading, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="hero section-wrap">
  <p class="hero-eyebrow">{eyebrow}</p>
  <h1>{heading}</h1>
  <p class="hero-description">{description}</p>
  <div class="hero-actions">
    <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}</a>
    <a class="btn btn-secondary" href={secondaryCta.href}>{secondaryCta.label}</a>
  </div>
</section>
